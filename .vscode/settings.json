{
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "editor.formatOnSave": true,
  "cSpell.words": [
    "bullmq",
    "codexygo",
    "CODEXYGO",
    "gundam",
    "Gundam",
    "mikro",
    "Mikro",
    "warhammer"
  ]
}
